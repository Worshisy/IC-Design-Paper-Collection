{# [c] whole file: the topic-survey index, built from surveys/<topic>/out/meta.json #}
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Topic surveys</title>
    <style>
      :root { --bg:#f5f5f7; --bg-alt:#fff; --text:#111827; --mute:#4b5563; --accent:#2563eb; --border:#d1d5db; }
      @media (prefers-color-scheme: dark) {
        :root { --bg:#111318; --bg-alt:#1b1e25; --text:#e5e7eb; --mute:#9ca3af; --accent:#7aa2f7; --border:#374151; }
      }
      * { box-sizing: border-box; }
      body { margin:0; padding:2rem 1rem; font-family: system-ui, -apple-system, "Segoe UI", sans-serif; background:var(--bg); color:var(--text); }
      .container { max-width: 860px; margin: 0 auto; }
      h1 { margin: 0 0 .4rem; font-size: 1.75rem; }
      p.lead { color: var(--mute); margin: 0 0 1.5rem; }
      a { color: var(--accent); }
      .card { background:var(--bg-alt); border:1px solid var(--border); border-radius:.75rem; padding:1rem 1.25rem; margin-bottom:1rem; }
      .card h2 { margin:0 0 .35rem; font-size:1.15rem; }
      .card h2 a { text-decoration:none; }
      .card h2 a::after { content:" →"; }
      .meta { color:var(--mute); font-size:.9rem; margin:.2rem 0 .7rem; }
      .areas { display:grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap:.75rem; }
      .areas h3 { font-size:.95rem; margin:0 0 .3rem; }
      .areas ul { list-style:none; margin:0; padding:0; }
      .areas li { display:flex; justify-content:space-between; gap:.5rem; padding:.15rem 0; border-bottom:1px dashed var(--border); }
      .n { color:var(--mute); font-variant-numeric: tabular-nums; }
      .back { display:inline-block; margin-bottom:1rem; }
    </style>
  </head>
  <body>
    <div class="container">
      <a class="back" href="../index.html">← All sources</a>
      <h1>Topic surveys</h1>
      <p class="lead">Lists of papers on one question, judged from titles and abstracts in this log.
        Each covers the papers present when it was run; newer papers need a re-run.</p>
      {% for s in surveys %}
      <div class="card">
        <h2><a href="{{ s.report }}">{{ s.title }}</a></h2>
        {% if s.reviews %}<div class="meta">Literature review:
          {% for level, page in s.reviews.items() %}{% set lv = level.split('-', 1) %}<a href="{{ page }}"><b>{{ lv[0] | capitalize }}</b>{% if lv | length > 1 %} ({{ lv[1] }}){% endif %}</a>{% if not loop.last %} · {% endif %}{% endfor %}{# focused reviews: mid-<slug> -> Mid (<slug>)  [c] #}
        </div>{% endif %}
        <div class="meta">
          Run {{ s.candidates_run or "?" }} · dataset as of {{ s.dataset_as_of or "?" }} ·
          papers {{ s.years_found | join("–") }} · {{ s.sources | length }} sources ·
          {{ s.judged }} judged, <b>{{ s.included }}</b> included{% if s.borderline %}, {{ s.borderline }} borderline{% endif %}
        </div>
        <div class="areas">
          {% for a in s.areas %}
          <div>
            <h3><a href="{{ s.report }}#{{ a.anchor }}">{{ a.category }}</a></h3>
            <ul>
              {% for g in a.subgroups %}
              <li><a href="{{ s.report }}#{{ g.anchor }}">{{ g.name }}</a><span class="n">{{ g.count }}</span></li>
              {% endfor %}
            </ul>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
    </div>
  </body>
</html>
