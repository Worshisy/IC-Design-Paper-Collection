<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{{ conference_name }} – Search All Papers</title>
    <style>
      :root {
        color-scheme: light dark;
        --bg: #f5f5f7;
        --bg-alt: #ffffff;
        --text: #111827;
        --accent: #2563eb;
        --border: #d1d5db;
        --muted: #6b7280;
      }

      /* Dark theme overrides */
      body.theme-dark {
        --bg: #020617;
        --bg-alt: #020617;
        --text: #e5e7eb;
        --accent: #38bdf8;
        --border: #1f2937;
        --muted: #9ca3af;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        padding: 1.2rem 1.5rem;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: var(--bg);
        color: var(--text);
        font-size: 0.9rem;
      }

      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }

      .container { max-width: 1400px; margin: 0 auto; }

      h1 { margin: 0 0 0.3rem; font-size: 1.6rem; }
      .subtitle { color: var(--muted); font-size: 0.85rem; margin-bottom: 1rem; }

      /* ---- Year cards ---- */
      .years-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1.2rem;
      }

      .year-card {
        padding: 0.35rem 0.65rem;
        border-radius: 0.5rem;
        background: var(--bg-alt);
        border: 1px solid var(--border);
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
        transition: border-color 0.12s, box-shadow 0.12s;
        min-width: 80px;
        text-align: center;
      }
      .year-card:hover { border-color: var(--accent); box-shadow: 0 4px 10px rgba(0,0,0,0.08); }
      .year-label { font-weight: 700; font-size: 1rem; }
      .year-meta { font-size: 0.7rem; color: var(--muted); }

      /* ---- Search panel ---- */
      .search-panel {
        background: var(--bg-alt);
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        padding: 0.9rem 1rem;
        margin-bottom: 0.8rem;
      }

      .search-panel h2 {
        margin: 0 0 0.6rem;
        font-size: 1rem;
        font-weight: 600;
      }

      .search-fields {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 0.75rem;
        align-items: flex-end;
      }

      .search-field {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
      }

      .search-field label {
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }

      .search-field input, .search-field select {
        padding: 0.38rem 0.55rem;
        border-radius: 0.4rem;
        border: 1px solid var(--border);
        font-size: 0.85rem;
        background: var(--bg);
        color: var(--text);
        min-width: 180px;
      }

      .search-field input:focus, .search-field select:focus {
        outline: 2px solid var(--accent);
        outline-offset: 1px;
      }

      .search-field.narrow input { min-width: 80px; max-width: 120px; }

      .search-actions {
        display: flex;
        gap: 0.4rem;
        align-items: flex-end;
        padding-bottom: 1px;
      }

      button {
        padding: 0.38rem 0.85rem;
        border-radius: 0.4rem;
        border: 1px solid var(--border);
        font-size: 0.85rem;
        cursor: pointer;
        background: var(--bg-alt);
        color: var(--text);
      }
      button.primary {
        background: var(--accent);
        color: #fff;
        border-color: var(--accent);
      }
      button:hover { opacity: 0.88; }

      .search-status {
        font-size: 0.78rem;
        color: var(--muted);
        margin-top: 0.4rem;
      }

      /* ---- Results table ---- */
      .table-wrapper {
        border: 1px solid var(--border);
        border-radius: 0.6rem;
        overflow: auto;
        background: var(--bg-alt);
        max-height: calc(100vh - 320px);
      }

      table {
        border-collapse: collapse;
        width: 100%;
        font-size: 0.8rem;
        table-layout: fixed;
      }

      col.col-year   { width: 52px; }
      col.col-num    { width: 60px; }
      col.col-title  { width: 280px; }
      col.col-abs    { width: auto; }
      col.col-au     { width: 200px; }

      thead {
        position: sticky;
        top: 0;
        z-index: 5;
        background: var(--bg-alt);
      }

      th, td {
        padding: 0.35rem 0.5rem;
        border-bottom: 1px solid #e5e7eb;
        vertical-align: top;
        overflow: hidden;
      }

      th {
        text-align: left;
        font-weight: 600;
        font-size: 0.75rem;
        white-space: nowrap;
        position: relative;
        user-select: none;
        cursor: pointer;
      }
      th::after { content: " ⇅"; font-size: 0.55rem; color: var(--muted); }

      /* Resize handle */
      th .rh {
        position: absolute; right: 0; top: 0; bottom: 0;
        width: 5px; cursor: col-resize; background: transparent;
      }
      th .rh:hover { background: var(--accent); opacity: 0.3; }

      td {
        line-height: 1.35;
      }

      td .ct {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      /* Density presets for index table */
      body.density-small table {
        font-size: 0.75rem;
      }
      body.density-medium table {
        font-size: 0.82rem;
      }
      body.density-large table {
        font-size: 0.9rem;
      }

      body.density-small td .ct {
        -webkit-line-clamp: 1;
      }
      body.density-medium td .ct {
        -webkit-line-clamp: 2;
      }
      body.density-large td .ct {
        -webkit-line-clamp: 4;
      }

      body.density-small td {
        padding: 0.25rem 0.45rem;
      }
      body.density-medium td {
        padding: 0.35rem 0.5rem;
      }
      body.density-large td {
        padding: 0.45rem 0.6rem;
      }

      tr:nth-child(even) td { background: #f9fafb; }
      body.theme-dark tr:nth-child(even) td { background: #020617; }
      body.theme-dark tr:nth-child(odd) td { background: transparent; }

      .mono {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.75rem;
      }

      .year-badge {
        display: inline-block;
        padding: 0.05rem 0.3rem;
        border-radius: 0.3rem;
        background: #eff6ff;
        color: var(--accent);
        font-weight: 600;
        font-size: 0.75rem;
        text-decoration: none;
      }
      .year-badge:hover { background: #dbeafe; }
      body.theme-dark .year-badge {
        background: #0b1120;
        border: 1px solid #1f2937;
      }

      td.ab-cell { font-size: 0.72rem; color: var(--muted); }

      .no-results {
        padding: 2rem;
        text-align: center;
        color: var(--muted);
        font-size: 0.9rem;
      }

      footer { margin-top: 1.5rem; font-size: 0.72rem; color: var(--muted); }

      @media (max-width: 640px) {
        .search-fields { flex-direction: column; }
        .table-wrapper { max-height: none; }
        table { table-layout: auto; }
      }
    </style>
    <script>
      window.MathJax = {
        tex: { inlineMath: [['$', '$'], ['\\\\(', '\\\\)']] },
        svg: { fontCache: 'global' }
      };
    </script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js"></script>
  </head>
  <body>
    <div class="container">
      <div class="top-links" style="margin-bottom:0.5rem;font-size:0.85rem;display:flex;align-items:center;gap:0.75rem">
        <a href="../index.html">← All conferences</a>
        <button type="button" id="theme-toggle" style="margin-left:auto;font-size:0.75rem;border-radius:999px;padding:0.15rem 0.6rem;border:1px solid var(--border);background:var(--bg-alt);color:var(--muted);cursor:pointer;">
          Dark mode
        </button>
      </div>
      <h1>{{ conference_name }} Proceedings</h1>
      <p class="subtitle">
        {{ years | sum(attribute='total_papers') }} papers across {{ years | length }} years. 
        Browse by year or search all papers below.
      </p>

      <div class="years-grid">
        {% for s in special_entries %}
        <a class="year-card" href="{{ s.href }}">
          <div class="year-label">{{ s.label }}</div>
          <div class="year-meta">{{ s.meta }}</div>
        </a>
        {% endfor %}
        {% for y in years %}
        <a class="year-card" href="year_{{ y.year }}.html">
          <div class="year-label">{{ y.year }}</div>
          <div class="year-meta">{{ y.total_sessions }}s · {{ y.total_papers }}p</div>
        </a>
        {% endfor %}
      </div>

      <div class="search-panel">
        <h2>Search all papers</h2>
        <div class="search-fields">
          <div class="search-field" style="flex:2">
            <label>Title / Abstract</label>
            <input id="q-text" type="search" placeholder="e.g. delta-sigma ADC" autocomplete="off" />
          </div>
          <div class="search-field" style="flex:1.5">
            <label>Author</label>
            <input id="q-author" type="search" placeholder="e.g. Murmann" autocomplete="off" />
          </div>
          <div class="search-field narrow">
            <label>Year</label>
            <select id="q-year">
              <option value="">Any</option>
              {% for y in years %}
              <option value="{{ y.year }}">{{ y.year }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="search-actions">
            <button class="primary" id="btn-search">Search</button>
            <button id="btn-clear">Clear</button>
          </div>
        </div>
        <div class="search-status" id="status">Type to search across all {{ years | sum(attribute='total_papers') }} papers.</div>
      </div>

      <div class="search-panel" style="margin-top:0.4rem;padding-top:0.5rem;padding-bottom:0.5rem">
        <div class="density-control" style="margin:0">
          <span>Table size:</span>
          <div class="density-buttons">
            <button type="button" class="density-btn" data-density="small">Small</button>
            <button type="button" class="density-btn" data-density="medium">Medium</button>
            <button type="button" class="density-btn" data-density="large">Large</button>
          </div>
        </div>
      </div>

      <div id="results-area">
        <div class="table-wrapper" id="results-wrapper" style="display:none">
          <table id="results-table">
            <colgroup>
              <col class="col-year" />
              <col class="col-num" />
              <col class="col-title" />
              <col class="col-abs" />
              <col class="col-au" />
            </colgroup>
            <thead>
              <tr>
                <th data-col="y">Year<span class="rh"></span></th>
                <th data-col="pn">Paper<span class="rh"></span></th>
                <th data-col="t">Title<span class="rh"></span></th>
                <th data-col="ab">Abstract<span class="rh"></span></th>
                <th data-col="au">Authors<span class="rh"></span></th>
              </tr>
            </thead>
            <tbody id="results-tbody"></tbody>
          </table>
        </div>
        <div class="no-results" id="no-results" style="display:none">No papers match your query.</div>
      </div>

      <footer>Static HTML viewer · Data: IEEE Xplore REST API</footer>
    </div>

    <script>
    (function () {
      /* ---------- Data ---------- */
      const DATA = {{ papers_json }};

      /* ---------- DOM refs ---------- */
      const qText   = document.getElementById("q-text");
      const qAuthor = document.getElementById("q-author");
      const qYear   = document.getElementById("q-year");
      const btnSearch = document.getElementById("btn-search");
      const btnClear  = document.getElementById("btn-clear");
      const status    = document.getElementById("status");
      const wrapper   = document.getElementById("results-wrapper");
      const tbody     = document.getElementById("results-tbody");
      const noResults = document.getElementById("no-results");
      const table     = document.getElementById("results-table");

      /* ---------- Helpers ---------- */
      function norm(s) { return (s || "").toLowerCase(); }

      function tokenize(s) {
        return norm(s).split(/\s+/).filter(Boolean);
      }

      /* Match: every token in `tokens` must appear somewhere in `haystack`. */
      function matchTokens(tokens, haystack) {
        if (!tokens.length) return true;
        const h = norm(haystack);
        return tokens.every(t => h.includes(t));
      }

      function escape(s) {
        return (s || "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
      }

      /* ---------- Render ---------- */
      function renderRow(p) {
        const title = p.url
          ? `<a href="${p.url}" target="_blank" rel="noopener">${escape(p.t)}</a>`
          : escape(p.t);
        return `<tr>
          <td><a class="year-badge" href="year_${p.y}.html">${p.y}</a></td>
          <td><span class="mono">${escape(p.pn)}</span></td>
          <td class="title-cell"><div class="ct">${title}</div></td>
          <td class="ab-cell"><div class="ct">${escape(p.ab)}</div></td>
          <td><div class="ct">${escape(p.au)}</div></td>
        </tr>`;
      }

      /* ---------- Search ---------- */
      function doSearch() {
        const textQ   = tokenize(qText.value);
        const authorQ = tokenize(qAuthor.value);
        const yearQ   = qYear.value.trim();

        if (!textQ.length && !authorQ.length && !yearQ) {
          tbody.innerHTML = "";
          wrapper.style.display = "none";
          noResults.style.display = "none";
          status.textContent = `Type to search across all ${DATA.length} papers.`;
          return;
        }

        const results = DATA.filter(p => {
          if (yearQ && String(p.y) !== yearQ) return false;
          if (textQ.length && !matchTokens(textQ, p.t + " " + p.ab)) return false;
          if (authorQ.length && !matchTokens(authorQ, p.au)) return false;
          return true;
        });

        if (!results.length) {
          tbody.innerHTML = "";
          wrapper.style.display = "none";
          noResults.style.display = "";
          status.textContent = "No matches.";
          return;
        }

        if (window.MathJax && MathJax.typesetClear) {
          MathJax.typesetClear([tbody]);
        }
        tbody.innerHTML = results.map(renderRow).join("");
        wrapper.style.display = "";
        noResults.style.display = "none";
        status.textContent = `${results.length} paper${results.length !== 1 ? "s" : ""} found.`;
        if (window.MathJax && MathJax.typesetPromise) {
          MathJax.typesetPromise([tbody]).catch(function () {});
        }
      }

      function doClear() {
        qText.value = "";
        qAuthor.value = "";
        qYear.value = "";
        tbody.innerHTML = "";
        wrapper.style.display = "none";
        noResults.style.display = "none";
        status.textContent = `Type to search across all ${DATA.length} papers.`;
        qText.focus();
      }

      /* ---------- Events ---------- */
      btnSearch.addEventListener("click", doSearch);
      btnClear.addEventListener("click", doClear);

      /* Enter key triggers search from any input */
      [qText, qAuthor].forEach(el => {
        el.addEventListener("keydown", e => { if (e.key === "Enter") doSearch(); });
      });
      qYear.addEventListener("change", () => {
        if (qText.value || qAuthor.value || qYear.value) doSearch();
      });

      /* ---------- Density toggle ---------- */
      (function setupDensity() {
        const buttons = Array.from(document.querySelectorAll(".density-btn"));
        function applyDensity(d) {
          document.body.classList.remove("density-small", "density-medium", "density-large");
          document.body.classList.add("density-" + d);
          buttons.forEach(b => b.classList.toggle("active", b.dataset.density === d));
        }
        buttons.forEach(btn => {
          btn.addEventListener("click", () => applyDensity(btn.dataset.density || "medium"));
        });
        applyDensity("medium");
      })();

      /* ---------- Column sort ---------- */
      table.querySelectorAll("thead th").forEach(th => {
        th.addEventListener("click", e => {
          if (e.target.classList.contains("rh")) return;
          const col = th.dataset.col;
          const asc = !th.dataset.sortDir || th.dataset.sortDir === "desc";
          th.dataset.sortDir = asc ? "asc" : "desc";

          const rows = Array.from(tbody.querySelectorAll("tr"));
          const ci = Array.from(th.parentNode.children).indexOf(th);

          rows.sort((a, b) => {
            const at = a.children[ci]?.textContent?.trim() || "";
            const bt = b.children[ci]?.textContent?.trim() || "";
            if (col === "y") {
              return asc ? Number(at) - Number(bt) : Number(bt) - Number(at);
            }
            return asc ? at.localeCompare(bt) : bt.localeCompare(at);
          });
          rows.forEach(r => tbody.appendChild(r));
        });
      });

      /* ---------- Column resize ---------- */
      table.querySelectorAll("th .rh").forEach(handle => {
        let startX, startW, col;
        handle.addEventListener("mousedown", e => {
          e.preventDefault();
          e.stopPropagation();
          const th = handle.parentElement;
          const ci = Array.from(th.parentNode.children).indexOf(th);
          col = table.querySelector("colgroup").children[ci];
          startX = e.pageX;
          startW = th.offsetWidth;

          function onMove(e2) {
            col.style.width = Math.max(40, startW + e2.pageX - startX) + "px";
          }
          function onUp() {
            document.removeEventListener("mousemove", onMove);
            document.removeEventListener("mouseup", onUp);
          }
          document.addEventListener("mousemove", onMove);
          document.addEventListener("mouseup", onUp);
        });
      });

      /* ---------- Theme toggle ---------- */
      (function setupTheme() {
        const btn = document.getElementById("theme-toggle");
        if (!btn) return;
        const KEY = "theme";
        function apply(theme) {
          document.body.classList.toggle("theme-dark", theme === "dark");
          document.body.classList.toggle("theme-light", theme === "light");
          btn.textContent = theme === "dark" ? "Light mode" : "Dark mode";
        }
        let stored = localStorage.getItem(KEY);
        if (stored !== "light" && stored !== "dark") {
          stored = "light";
        }
        apply(stored);
        btn.addEventListener("click", () => {
          stored = stored === "dark" ? "light" : "dark";
          localStorage.setItem(KEY, stored);
          apply(stored);
        });
      })();
    })();
    </script>
  </body>
</html>
