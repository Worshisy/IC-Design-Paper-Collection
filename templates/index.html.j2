<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ conference_name }} – Search All Papers</title>
    <style>
{% include "_styles.css.j2" %}
      .years-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(7.5rem, 1fr));
        gap: 0.5rem;
        margin-bottom: 0.8rem;
      }
      .year-card {
        display: block;
        padding: 0.55rem 0.7rem;
        border-radius: 0.5rem;
        background: var(--bg-alt);
        border: 1px solid var(--border);
        color: inherit;
        text-align: center;
        box-shadow: var(--shadow);
      }
      .year-card:hover { border-color: var(--accent); text-decoration: none; }
      .year-card.special { border-color: var(--accent); }
      .year-label { font-weight: 700; font-size: 1.05rem; }
      .year-meta { font-size: 0.7rem; color: var(--muted); }
      .search-fields { display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: flex-end; }
      .search-field { display: flex; flex-direction: column; gap: 0.2rem; flex: 1 1 12rem; }
      .search-field label { font-size: 0.7rem; color: var(--muted); }
      .search-status { font-size: 0.75rem; color: var(--muted); margin-top: 0.4rem; }
      button.primary { background: var(--accent); color: #fff; border-color: var(--accent); }
    </style>
  </head>
  <body>
    <div class="container">
      <header>
        <div class="topbar">
          <span class="muted">{{ conference_name }}</span>
          <span class="spacer"></span>
          <span class="sync-status" id="sync-status"></span>
          <button type="button" class="pill-btn" id="annot-export">Export marks</button>
          <button type="button" class="pill-btn" id="annot-import">Import</button>
          <input type="file" id="annot-import-input" accept="application/json" class="hidden" />
          <button type="button" class="pill-btn" id="theme-toggle">Dark mode</button>
        </div>
        <h1>{{ conference_name }} Proceedings</h1>
        <p class="muted" style="margin:0;font-size:0.85rem">
          {{ years | sum(attribute='total_papers') }} papers across {{ years | length }} years.
          Browse by year or search all papers below.
        </p>
      </header>

      <div class="years-grid">
        {% for s in special_entries %}
        <a class="year-card special" href="{{ s.href }}">
          <div class="year-label">{{ s.label }}</div>
          <div class="year-meta">{{ s.meta }}</div>
        </a>
        {% endfor %}
        {% for y in years %}
        <a class="year-card" href="year_{{ y.year }}.html">
          <div class="year-label">{{ y.year }}</div>
          <div class="year-meta">{{ y.total_sessions }}s · {{ y.total_papers }}p</div>
        </a>
        {% endfor %}
      </div>

      <div class="panel">
        <h2>Search all papers</h2>
        <div class="search-fields">
          <div class="search-field" style="flex:2 1 18rem">
            <label>Title / Abstract</label>
            <input id="q-text" class="text-input" type="search" placeholder="e.g. delta-sigma ADC" autocomplete="off" />
          </div>
          <div class="search-field">
            <label>Author</label>
            <input id="q-author" class="text-input" type="search" placeholder="e.g. Murmann" autocomplete="off" />
          </div>
          <div class="search-field" style="flex:0 1 8rem">
            <label>Year</label>
            <select id="q-year" class="text-input"></select>
          </div>
          <div class="search-field" style="flex:0 1 9rem">
            <label>Marks</label>
            <select id="q-mark" class="text-input">
              <option value="">any</option>
              <option value="__liked">liked only</option>
              <option value="to-read">to-read</option>
              <option value="reading">reading</option>
              <option value="read">read</option>
              <option value="important">important</option>
              <option value="reference">reference</option>
            </select>
          </div>
          <div class="search-field" style="flex:0 0 auto;flex-direction:row;gap:0.4rem">
            <button class="pill-btn primary" id="btn-search">Search</button>
            <button class="pill-btn" id="btn-clear">Clear</button>
          </div>
        </div>
        <div class="search-status" id="status">Type to search across all {{ years | sum(attribute='total_papers') }} papers.</div>
      </div>

      <div class="panel controls">
        <div class="control-group">
          <span>Size</span>
          <div class="seg">
            <button type="button" class="density-btn" data-density="small">S</button>
            <button type="button" class="density-btn" data-density="medium">M</button>
            <button type="button" class="density-btn" data-density="large">L</button>
          </div>
        </div>
        <div class="control-group">
          <button type="button" class="pill-btn" id="clamp-toggle">Shorten abstracts</button>
        </div>
      </div>

      <div id="results-area">
        <div class="paper-list" id="results-list">
          <div class="list-head" id="results-head">
            <span>Year · No.</span>
            <span>Title</span>
            <span class="h-abstract">Abstract</span>
            <span>Authors</span>
            <span>Marks</span>
          </div>
        </div>
        <div class="no-results hidden" id="no-results">No papers match your query.</div>
      </div>
    </div>

    <script>
      window.MathJax = {
        tex: { inlineMath: [["$", "$"], ["\\(", "\\)"]] },
        options: { skipHtmlTags: ["script", "noscript", "style", "textarea", "pre"] }
      };
    </script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js"></script>
    <script src="annotations.js" onerror="void 0"></script>
    <script>
{% include "_scripts.js.j2" %}
    </script>
    <script>
      const DATA = {{ papers_json | safe }};

      (function () {
        const qText = document.getElementById("q-text");
        const qAuthor = document.getElementById("q-author");
        const qYear = document.getElementById("q-year");
        const qMark = document.getElementById("q-mark");
        const statusEl = document.getElementById("status");
        const list = document.getElementById("results-list");
        const head = document.getElementById("results-head");
        const noResults = document.getElementById("no-results");
        const MAX_RENDER = 400;

        /* Year dropdown, newest first to match the year cards. */
        const years = Array.from(new Set(DATA.map(p => p.y))).sort((a, b) => b - a);
        qYear.innerHTML = '<option value="">all</option>' + years.map(y => `<option value="${y}">${y}</option>`).join("");

        function tokenize(s) {
          return (s || "").toLowerCase().split(/\s+/).map(t => t.trim()).filter(Boolean);
        }
        function matchTokens(tokens, haystack) {
          return tokens.every(t => haystack.includes(t));
        }

        function renderRow(p) {
          const row = document.createElement("div");
          row.className = "paper-row";
          row.dataset.id = p.id || "";

          const num = document.createElement("div");
          num.className = "cell-num";
          num.innerHTML = `<a href="year_${p.y}.html">${p.y}</a><br>${p.pn || ""}`;

          const title = document.createElement("div");
          title.className = "cell-title";
          if (p.url) {
            const a = document.createElement("a");
            a.href = p.url;           /* set as a property: never string-built */
            a.target = "_blank";
            a.rel = "noopener";
            a.textContent = p.t || "";
            title.appendChild(a);
          } else {
            title.textContent = p.t || "";
          }

          const abstract = document.createElement("div");
          abstract.className = "cell-abstract";
          abstract.textContent = p.ab || "";

          const authors = document.createElement("div");
          authors.className = "cell-authors";
          authors.appendChild(window.renderAuthors((p.au || "").split("; ").filter(Boolean), p.af || []));

          row.appendChild(num);
          row.appendChild(title);
          row.appendChild(abstract);
          row.appendChild(authors);
          row.appendChild(window.Annotations.buildControls(p.id || ""));
          if (window.Annotations.get(p.id || "").liked) row.classList.add("liked");
          return row;
        }

        function doSearch() {
          const textQ = tokenize(qText.value);
          const authorQ = tokenize(qAuthor.value);
          const yearQ = qYear.value.trim();
          const markQ = qMark.value;

          if (!textQ.length && !authorQ.length && !yearQ && !markQ) {
            clearResults();
            statusEl.textContent = `Type to search across all ${DATA.length} papers.`;
            return;
          }

          const matches = DATA.filter(p => {
            if (yearQ && String(p.y) !== yearQ) return false;
            if (markQ) {
              const ann = window.Annotations.get(p.id || "");
              if (markQ === "__liked") { if (!ann.liked) return false; }
              else if (ann.mark !== markQ) return false;
            }
            if (authorQ.length && !matchTokens(authorQ, (p.au || "").toLowerCase())) return false;
            if (textQ.length) {
              const hay = ((p.t || "") + " " + (p.ab || "")).toLowerCase();
              if (!matchTokens(textQ, hay)) return false;
            }
            return true;
          });

          clearResults();
          const slice = matches.slice(0, MAX_RENDER);
          const frag = document.createDocumentFragment();
          slice.forEach(p => frag.appendChild(renderRow(p)));
          list.appendChild(frag);

          head.classList.toggle("hidden", matches.length === 0);
          noResults.classList.toggle("hidden", matches.length > 0);
          statusEl.textContent = matches.length > MAX_RENDER
            ? `${matches.length} matches — showing the first ${MAX_RENDER}.`
            : `${matches.length} match${matches.length === 1 ? "" : "es"}.`;

          if (window.MathJax && window.MathJax.typesetPromise) {
            window.MathJax.typesetPromise([list]).catch(function () {});
          }
        }

        function clearResults() {
          Array.prototype.slice.call(list.querySelectorAll(".paper-row")).forEach(r => r.remove());
          noResults.classList.add("hidden");
          head.classList.add("hidden");
        }

        function doClear() {
          qText.value = ""; qAuthor.value = ""; qYear.value = ""; qMark.value = "";
          clearResults();
          statusEl.textContent = `Type to search across all ${DATA.length} papers.`;
        }

        let timer = null;
        function debounced() { clearTimeout(timer); timer = setTimeout(doSearch, 180); }

        qText.addEventListener("input", debounced);
        qAuthor.addEventListener("input", debounced);
        qYear.addEventListener("change", doSearch);
        qMark.addEventListener("change", doSearch);
        document.getElementById("btn-search").addEventListener("click", doSearch);
        document.getElementById("btn-clear").addEventListener("click", doClear);
        clearResults();
      })();
    </script>
  </body>
</html>
