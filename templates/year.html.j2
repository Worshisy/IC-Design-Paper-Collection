<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ conference_name }} – {{ year }}</title>
    <style>
{% include "_styles.css.j2" %}
    </style>
  </head>
  <body>
    <div class="container">
      <header>
        <div class="topbar">
          <a href="index.html">← All years</a>
          <span class="muted">{{ conference_name }} {{ year }}</span>
          <span class="spacer"></span>
          <span class="sync-status" id="sync-status"></span>
          <button type="button" class="pill-btn" id="annot-export">Export marks</button>
          <button type="button" class="pill-btn" id="annot-import">Import</button>
          <input type="file" id="annot-import-input" accept="application/json" class="hidden" />
          <button type="button" class="pill-btn" id="theme-toggle">Dark mode</button>
        </div>
        <h1>{{ conference_name }} {{ year }}</h1>
      </header>

      <div class="panel summary">
        <div><span class="big">{{ total_sessions }}</span> <span class="muted">sessions</span></div>
        <div><span class="big">{{ total_papers }}</span> <span class="muted">papers</span></div>
        {% if sessions %}
        <div class="chips">
          {% for s in sessions %}
          <a class="chip" href="#{{ s.anchor_id }}">{{ s.session_number }} · {{ s.session_name }} ({{ s.paper_count }})</a>
          {% endfor %}
        </div>
        {% endif %}
      </div>

      <div class="panel controls">
        <div class="control-group" style="flex:1 1 18rem">
          <input id="search-input" class="search-input" type="search"
            placeholder="Filter by title, authors, abstract…" />
        </div>
        <div class="control-group">
          <span>Size</span>
          <div class="seg">
            <button type="button" class="density-btn" data-density="small">S</button>
            <button type="button" class="density-btn" data-density="medium">M</button>
            <button type="button" class="density-btn" data-density="large">L</button>
          </div>
        </div>
        <div class="control-group">
          <button type="button" class="pill-btn" id="clamp-toggle">Shorten abstracts</button>
        </div>
        <div class="control-group">
          <label class="muted" style="font-size:0.75rem;display:flex;align-items:center;gap:0.3rem">
            <input type="checkbox" id="liked-only" /> Liked only
          </label>
        </div>
      </div>

      <div class="paper-list" id="paper-list">
        <div class="list-head">
          <span data-sort="num">Paper</span>
          <span data-sort="title">Title</span>
          <span class="h-abstract">Abstract</span>
          <span data-sort="authors">Authors</span>
          <span>Marks</span>
        </div>

        {% set ns = namespace(current=None) %}
        {% for row in rows %}
          {% if row.session_number != ns.current %}
            {% set ns.current = row.session_number %}
            <div class="session-row" id="session-{{ row.session_number }}">
              <span class="tag">Session {{ row.session_number }}</span>{{ row.session_name }}
            </div>
          {% endif %}
        <div class="paper-row"
             data-id="{{ row.article_number }}"
             data-authors="{{ row.authors | join('; ') }}"
             data-affils="{{ row.affiliations | join('|') }}">
          <div class="cell-num">{{ row.paper_number }}</div>
          <div class="cell-title">
            {% if row.paper_url %}<a href="{{ row.paper_url }}" target="_blank" rel="noopener">{{ row.title }}</a>
            {% else %}{{ row.title }}{% endif %}
          </div>
          <div class="cell-abstract">{{ row.abstract }}</div>
          <div class="cell-authors"></div>
        </div>
        {% endfor %}
      </div>
      <div class="no-results hidden" id="no-results">No papers match your filter.</div>
    </div>

    <script>
      window.MathJax = {
        tex: { inlineMath: [["$", "$"], ["\\(", "\\)"]] },
        options: { skipHtmlTags: ["script", "noscript", "style", "textarea", "pre"] }
      };
    </script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js"></script>
    <script src="annotations.js" onerror="void 0"></script>
    <script>
{% include "_scripts.js.j2" %}
    </script>
    <script>
      (function () {
        var rows = Array.prototype.slice.call(document.querySelectorAll(".paper-row"));
        var sessionRows = Array.prototype.slice.call(document.querySelectorAll(".session-row"));
        var noResults = document.getElementById("no-results");

        /* Authors + affiliation tooltips, and the per-paper mark controls. */
        rows.forEach(function (row) {
          var names = (row.dataset.authors || "").split("; ").filter(Boolean);
          var affils = (row.dataset.affils || "").split("|");
          var cell = row.querySelector(".cell-authors");
          cell.appendChild(window.renderAuthors(names, affils));
          row.appendChild(window.Annotations.buildControls(row.dataset.id || ""));
          row._haystack = (row.textContent || "").toLowerCase();
        });

        /* Filter */
        var input = document.getElementById("search-input");
        var likedOnly = document.getElementById("liked-only");
        function filter() {
          var q = (input.value || "").toLowerCase().trim();
          var onlyLiked = likedOnly.checked;
          var shown = 0;
          rows.forEach(function (row) {
            var ok = (!q || row._haystack.indexOf(q) !== -1);
            if (ok && onlyLiked) ok = !!window.Annotations.get(row.dataset.id).liked;
            row.classList.toggle("hidden", !ok);
            if (ok) shown++;
          });
          /* Hide a session header when every paper under it is filtered out. */
          sessionRows.forEach(function (sr) {
            var node = sr.nextElementSibling;
            var any = false;
            while (node && !node.classList.contains("session-row")) {
              if (node.classList.contains("paper-row") && !node.classList.contains("hidden")) { any = true; break; }
              node = node.nextElementSibling;
            }
            sr.classList.toggle("hidden", !any);
          });
          noResults.classList.toggle("hidden", shown > 0);
        }
        input.addEventListener("input", filter);
        likedOnly.addEventListener("change", filter);

        /* Sorting within the flat list (keeps session headers where they are
           when unsorted; sorting flattens the list by design). */
        var list = document.getElementById("paper-list");
        var sortState = {};
        document.querySelectorAll(".list-head [data-sort]").forEach(function (h) {
          h.addEventListener("click", function () {
            var key = h.dataset.sort;
            var dir = sortState[key] = (sortState[key] === 1 ? -1 : 1);
            var sorted = rows.slice().sort(function (a, b) {
              var av, bv;
              if (key === "num") {
                var pa = (a.querySelector(".cell-num").textContent || "").split(".").map(Number);
                var pb = (b.querySelector(".cell-num").textContent || "").split(".").map(Number);
                av = (pa[0] || 0) * 1000 + (pa[1] || 0);
                bv = (pb[0] || 0) * 1000 + (pb[1] || 0);
              } else if (key === "title") {
                av = (a.querySelector(".cell-title").textContent || "").trim().toLowerCase();
                bv = (b.querySelector(".cell-title").textContent || "").trim().toLowerCase();
              } else {
                av = (a.dataset.authors || "").toLowerCase();
                bv = (b.dataset.authors || "").toLowerCase();
              }
              return av < bv ? -dir : av > bv ? dir : 0;
            });
            sessionRows.forEach(function (sr) { sr.classList.add("hidden"); });
            sorted.forEach(function (r) { list.appendChild(r); });
          });
        });
      })();
    </script>
  </body>
</html>
